{
  "name": "taiwanbot-frontend",
  "version": "0.1.0",
  "private": true,
  "description": "TaiwanBot 台湾腔治愈系桌面小管家前端（Electron + React + Vite）",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev:vite": "vite",
    "dev:electron": "wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .",
    "dev": "concurrently -k -n VITE,ELECTRON \"npm run dev:vite\" \"npm run dev:electron\"",
    "dev:all": "concurrently -k -n BACKEND,VITE,ELECTRON \"..\\backend\\.venv\\Scripts\\python.exe -m uvicorn app.main:app --app-dir ..\\backend --host 127.0.0.1 --port 8765\" \"npm run dev:vite\" \"npm run dev:electron\"",
    "build": "tsc --noEmit && vite build",
    "package:win": "npm run build && npx electron-builder --win nsis"
  },
  "build": {
    "appId": "com.taiwanbot.linger",
    "productName": "灵儿管家",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^45.4.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "wait-on": "^8.0.2"
  }
}
